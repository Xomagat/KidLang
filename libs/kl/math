// -----------------------   функции   ---------------------------------------------

double синус(const double x) { return std::sin(x); }
KL_EXPORT(синус)

double косинус(const double x) { return std::cos(x); }
KL_EXPORT(косинус)

double тангенс(const double x) { return std::tan(x); }
KL_EXPORT(тангенс)

double степень(const double x, const double y) { return std::pow(x, y); }
KL_EXPORT(степень)

double корень(const double x) { return std::sqrt(x); }
KL_EXPORT(корень)

double экспонента(const double x) { return std::exp(x); }
KL_EXPORT(экспонента)

double логарифм(const double x) { return std::log(x); }
KL_EXPORT(логарифм)

double логарифм10(const double x) { return std::log10(x); }
KL_EXPORT(логарифм10)

double логарифм2(const double x) { return std::log2(x); }
KL_EXPORT(логарифм2)

double гиперболический_синус(const double x) { return std::sinh(x); }
KL_EXPORT(гиперболический_синус)

double гиперболический_косинус(const double x) { return std::cosh(x); }
KL_EXPORT(гиперболический_косинус)

double гиперболический_тангенс(const double x) { return std::tanh(x); }
