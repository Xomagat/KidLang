double остаток(const double x, const double y) { return std::fmod(x, y); }
KL_EXPORT(остаток)

double минимум(const double x, const double y) { return std::min(x, y); }
KL_EXPORT(минимум)

double максимум(const double x, const double y) { return std::max(x, y); }
KL_EXPORT(максимум)

