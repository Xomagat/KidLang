используй файлы

файл н1 = открыть("заметки.txt")

н1.текст = "Купить хлеб"
н1.текст += "\нПойти в магазин"

покажи(н1.текст)
покажи(н1.размер)
покажи(н1.путь)
покажи(н1.имя)

покажи(н1.открыт)
н1.закрыть()
покажи(н1.открыт)

для текст строка из прочитать_строки("заметки.txt")
    покажи("• " + строка)

если существует("заметки.txt")
    удалить_файл("заметки.txt")