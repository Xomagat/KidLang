список число оценки = [5, 4, 3]
список текст имена = ["Аня", "Боря"]
список число пустой = []

покажи(оценки[0])            ; 5 — индексация с нуля, как у твоего текст.символ
оценки[1] = 10               ; присвоить по номеру
оценки.добавить(2)
покажи(оценки.длина())

для число x из оценки        ; новый вариант цикла
    покажи(x)

список список число таблица = [[1, 2], [3, 4]]   ; вложенные списки получаются сами

покажи(оценки.тип())
покажи(имена.тип())
покажи(пустой.тип())