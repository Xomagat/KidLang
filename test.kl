словарь(текст, число) возраст = {"Маша": 7, "Петя": 8}
список(число) числа = [1, 2, 3]

рецепт найти(словарь(текст, число) m, текст имя) вернет число
    верни m[имя]

словарь(текст, список(число)) оценки = {"Маша": [5, 4], "Петя": [3]}
для текст имя из оценки.ключи()
    покажи(имя)

покажи(оценки.значения()[0].длина())