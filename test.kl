класс Собака
    текст имя
    число возраст = 0

    рецепт создать(текст имя, число возраст)
        это.имя = имя
        это.возраст = возраст

    рецепт гавкни()
        покажи(это.имя + " говорит: гав!")

    рецепт повзрослеть()
        это.возраст += 1

Собака рекс = Собака("Рекс", 3)
рекс.гавкни()
рекс.повзрослеть()
покажи(рекс.возраст)